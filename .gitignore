# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/tmp/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Large local-only source videos
public/images/**/*.mov
*.mov

# Runtime audit evidence stays local until the old-site comparison is complete.
docs/runtime-site-audit/screenshots/

# Local archives
*.zip

# Land lead alert working data.
# Contains ~170 MB of county exports plus buyer names and home mailing
# addresses. This is personal information about real people: it stays on the
# local machine and must never be committed or pushed.
/.land-leads-data/
# Service-account key for the lead spreadsheet.
land-leads-service-account*.json
