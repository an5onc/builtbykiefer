<?xml version="1.0" encoding="UTF-8"?>
<!--
  Runs the land lead alert every morning at 8:00.

  Install:
    cp scripts/land-leads/com.builtbykiefer.landleads.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.builtbykiefer.landleads.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.builtbykiefer.landleads.plist

  The script reads the project's .env file itself, so API keys do NOT need to be
  repeated here. Only add something to EnvironmentVariables below if you want it
  to override .env for the scheduled run specifically.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.builtbykiefer.landleads</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>node</string>
    <string>/Users/ansoncordeiro/dev/builtbykiefer/scripts/land-leads/run.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/ansoncordeiro/dev/builtbykiefer</string>

  <!--
    Keys come from .env automatically. PATH is set here only so launchd can
    find node, which it otherwise cannot.
  -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>

  <!-- 8:00 every morning. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <!-- If the Mac was asleep at 8:00, run once it wakes. -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/ansoncordeiro/dev/builtbykiefer/.land-leads-data/run.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ansoncordeiro/dev/builtbykiefer/.land-leads-data/run.log</string>
</dict>
</plist>
