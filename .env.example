# Copy this file to .env and fill in the real values:
#   cp .env.example .env
#
# .env is git-ignored and must never be committed.

# Quote request email delivery
RESEND_API_KEY=
CONTACT_EMAIL_FROM="Kiefer Built <quotes@builtbykiefer.com>"
CONTACT_EMAIL_TO=info@kbuiltco.com

# --- Land purchase lead alert ----------------------------------------------
# Uses the same RESEND_API_KEY above.

# Where the "new land buyers" alert is sent. Comma-separate for several people.
LAND_LEADS_ALERT_TO=
# Sender. Reuses the domain already verified in Resend for quote emails.
LAND_LEADS_ALERT_FROM="Land Leads <quotes@builtbykiefer.com>"

# Optional live Google Sheet. Leave both blank to use the local CSV instead.
# These are NOT commented out on purpose: a value pasted after a '#' is ignored.

# The id from docs.google.com/spreadsheets/d/<THIS_PART>/edit
LAND_LEADS_SHEET_ID=
# Absolute path to the downloaded service-account key. Keep it OUTSIDE this repo.
GOOGLE_SERVICE_ACCOUNT_JSON=
